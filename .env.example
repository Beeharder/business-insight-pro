# Copy this file to ".env" and fill in real values.
#   cp .env.example .env
#
# .env is listed in .gitignore and must never be committed.
# Nothing in Phase 0 requires these keys except `python cli.py check-sources`
# and the live ingest commands. The demo backtest runs without any of them.

# --- Broker / market data (Alpaca paper trading) -----------------------------
# Exactly where to click:
#   1. Sign up / log in at https://alpaca.markets
#   2. Make sure the dashboard is switched to PAPER, not Live. Keys are separate
#      for each, and a Live key here would be pointed at real money.
#   3. On the Home tab, find the "API Keys" section
#   4. Click "Generate New Keys"
#   5. Copy both values below. The secret is shown ONCE - if you lose it,
#      generate a new pair rather than hunting for it.
#
# These two strings are all the authentication needed. You do NOT need OAuth,
# tokens, a client_id, or anything from authx.alpaca.markets - that is Alpaca's
# Broker API, meant for companies running their own brokerage on Alpaca's
# infrastructure. Wrong product, and it is easy to land on by accident.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# --- SEC EDGAR ---------------------------------------------------------------
# EDGAR requires no key, but it DOES require a descriptive User-Agent with a
# real contact email, or it will block you. Format: "Name email@domain.com"
EDGAR_USER_AGENT=

# --- News (Phase 0 decision: see docs/SOURCE_VIABILITY.md) -------------------
# Set NEWS_PROVIDER to whichever archive you picked.
NEWS_PROVIDER=
NEWS_API_KEY=

# --- Transcripts (needed for Strategy B2 only) -------------------------------
TRANSCRIPTS_PROVIDER=
TRANSCRIPTS_API_KEY=

# --- LLM (not used until Phase 2) --------------------------------------------
ANTHROPIC_API_KEY=

# --- Digest email (not used until Phase 4) -----------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=
